# LumaDesign backend settings. Copy this file to .env and fill it in (see docs/ADMIN-SETUP.md, step 3).
# .env is never committed: it holds secret keys.

# Supabase > Project Settings > Data API > Project URL
SUPABASE_URL=

# Supabase > Project Settings > API Keys > the "anon" / "publishable" key (public by design)
SUPABASE_ANON_KEY=

# Supabase > Project Settings > API Keys > the "service_role" / "secret" key (SECRET: never share)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase > Connect (top of the dashboard) > "Session pooler" connection string,
# with [YOUR-PASSWORD] replaced by your database password (SECRET)
SUPABASE_DB_URL=

# The admin login email. Leave as it is unless you want a different one.
ADMIN_EMAIL=admin@yourwebsite.com
